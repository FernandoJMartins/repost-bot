# Quase tudo é configurado pela página web (token, origem, destino, admin, limites).
# Aqui ficam apenas as opções de inicialização do processo. Todas são opcionais.

# Endereço da página web. Mantenha 127.0.0.1 (só esta máquina).
# Para acessar de fora, use túnel SSH/VPN/proxy com HTTPS — nunca exponha direto na internet.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Login inicial da página. Padrão: usuário admin / senha admin.
# Só vale no primeiro início; depois, troque pela própria página (seção Conta).
WEB_USER=
WEB_PASSWORD=

DB_PATH=data/repost.db
LOG_LEVEL=INFO
LOG_FILE=logs/repost-bot.log

# Compatibilidade com a versão anterior: se definidos, são importados para o banco
# apenas na primeira vez (depois disso vale o que estiver na página web).
# BOT_TOKEN=
# SOURCE_CHAT_ID=
# DEST_CHAT_ID=
# ADMIN_USER_ID=
